$header
library ieee;
    use ieee.std_logic_1164.all;

library vunit_lib;
    context vunit_lib.vunit_run_context;

library uvvm_util;
    context uvvm_util.uvvm_util_context;

library uvvm_vvc_framework;
    use uvvm_vvc_framework.ti_vvc_framework_support_pkg.all;

library bitvis_vip_axilite;
    use bitvis_vip_axilite.vvc_methods_pkg.all;

library bitvis_vip_axistream;
    use bitvis_vip_axistream.vvc_methods_pkg.AXISTREAM_VVCT;

library osh_tb;
    use osh_tb.osh_tb_pkg.all;

use work.${entity}_th_pkg.all;

-- System testbench of the system
--   $entity
-- with its harness ${entity}_th and the test cases. This file is yours: openspacehdl update regenerates the
-- harness and its package, never this file.
entity ${entity}_tb is
    generic (
        runner_cfg : string
    );
end entity ${entity}_tb;

architecture sim of ${entity}_tb is
begin

    i_harness : entity work.${entity}_th;

    p_main : process
    begin
        test_runner_setup(runner, runner_cfg);
        -- UVVM engine ready, the log of positive checks off (osh_tb_pkg)
        osh_test_start;
        while test_suite loop
            if run("test_smoke") then
                -- Reset, link start and link up, the ID register of every register bank, the memory of the RMAP
                -- targets behind a link (osh_smoke_test of the harness package)
                osh_smoke_test(osh_rst, AXILITE_VVCT, osh_rmap_cmd, osh_rmap_res, osh_link_up);
            elsif run("test_streams") then
                -- Reset, link start and link up, packets through the ports of OpenSPP and the far ends, every
                -- processing chain towards a link, the counters of their cores (osh_stream_test)
                osh_stream_test(osh_rst, AXILITE_VVCT, AXISTREAM_VVCT, osh_link_up);$image_test
            end if;
        end loop;
        -- Fails on an unexpected alert and on an expected alert that did not occur
        osh_test_end(runner);
    end process;

end architecture sim;
